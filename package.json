{
  "name": "eduflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EduFlow: a learning platform you can actually learn from. Sixteen courses, 300+ real lessons with quizzes, runnable code, flashcards and streaks, in English and Arabic, offline. A front-end portfolio project.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run content && vite",
    "content": "node scripts/content/build.mjs",
    "build": "npm run content && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs 4173",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "images": "node scripts/images.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:content": "node scripts/content/check-exercises.mjs",
    "shots": "node scripts/readme-shots/capture.mjs && node scripts/readme-shots/frame.mjs && node scripts/readme-shots/tour.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run check:bundle && npm run check:content && npm run test:e2e",
    "pretest": "npm run content"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "pyodide": "^0.29.3",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "sql.js": "^1.14.2",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
